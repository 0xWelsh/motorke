{
  "name": "motorke",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:deploy": "bash scripts/migrate-deploy.sh",
    "build:local": "bash ./scripts/build-local.sh",
    "start": "next start",
    "lint": "eslint \"src/app/api/auth/**/*.js\" \"src/lib/google-auth.js\" \"src/lib/validate-env.js\" \"jest.setup.js\"",
    "lint:full": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"__tests__/**/*.js\"",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:backfill-slugs": "node scripts/backfill-car-public-slugs.mjs",
    "db:seed-duty": "node prisma/seed-duty-vehicles.mjs",
    "db:import-crsp": "node scripts/import-duty-crsp.mjs",
    "db:seed-seo-content": "node scripts/seed-seo-content.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:sync-gsc": "node scripts/seo-sync-gsc.mjs",
    "seo:check-google": "node scripts/check-google-setup.mjs",
    "db:push:local": "bash ./scripts/build-local.sh --sync-only",
    "db:seed": "node prisma/seed.js",
    "db:seed-specs": "node prisma/seed-car-model-specs.mjs",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "postinstall": "prisma generate",
    "rewatermark": "node --env-file=.env.local scripts/rewatermark-existing-images.js",
    "rewatermark:dry-run": "node --env-file=.env.local scripts/rewatermark-existing-images.js --dry-run",
    "rewatermark:recent-5": "node --env-file=.env.local scripts/rewatermark-existing-images.js --recent-cars=5",
    "watermark:build": "node scripts/generate-watermark.mjs",
    "cap:sync": "next build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:dev": "npm run cap:sync && npm run cap:android",
    "cap:build:android": "npm run cap:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/analytics": "^2.0.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "google-auth-library": "^10.6.2",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lucide-react": "^1.7.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.4",
    "playwright": "^1.62.0",
    "puppeteer-core": "^25.3.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "stripe": "^22.0.0",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^6.0.3",
    "whatwg-fetch": "^3.6.20"
  }
}
