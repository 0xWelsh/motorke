generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  role          UserRole   @default(BUYER)
  name          String
  avatarUrl     String?
  dealerId      String?
  active        Boolean    @default(true)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  googleId      String?    @unique
  lat           Float?
  lng           Float?
  savedCars     SavedCar[]
  sessions      Session[]
  notifications Notification[]
  dealerReviews DealerReview[]
  carReviews    CarReview[]
  carViews      CarView[]
  dealer        Dealer?    @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("GENERAL")
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model SavedCar {
  id        String   @id @default(cuid())
  userId    String
  carId     String
  createdAt DateTime @default(now())
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@map("saved_cars")
}

model Dealer {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String?
  logoUrl      String?
  bannerUrl    String?
  phone        String
  whatsapp     String?
  email        String?
  website      String?
  location     String
  county       String         @default("Nairobi")
  address      String?
  lat          Float?
  lng          Float?
  verified     Boolean        @default(false)
  featured     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  cars         Car[]
  branches     DealerBranch[]
  leads        Lead[]
  reviews      DealerReview[]
  subscription Subscription?
  users        User[]

  @@index([county])
  @@map("dealers")
}

model DealerBranch {
  id        String   @id @default(cuid())
  dealerId  String
  name      String
  location  String
  county    String   @default("Nairobi")
  address   String?
  lat       Float?
  lng       Float?
  phone     String?
  whatsapp  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cars      Car[]
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@map("dealer_branches")
}

model Car {
  id             String        @id @default(cuid())
  dealerId       String
  make           String
  model          String
  variant        String?
  year           Int
  condition      Condition     @default(USED)
  price          Int
  negotiable     Boolean       @default(true)
  mileage        Int?
  fuelType       FuelType      @default(PETROL)
  transmission   Transmission  @default(AUTOMATIC)
  engineCC       Int?
  bodyType       BodyType      @default(SEDAN)
  color          String?
  doors          Int?          @default(4)
  seats          Int?          @default(5)
  imported       Boolean       @default(true)
  importCountry  String?       @default("Japan")
  dutyPaid       Boolean       @default(true)
  description    String?
  features       String[]
  videoUrl       String?
  available      Boolean       @default(true)
  featured       Boolean       @default(false)
  views          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  branchId       String?
  drivetrain     Drivetrain    @default(FWD)
  badges         String[]
  airbags        Int?          @default(0)
  cylinders      Int?
  horsepower     Int?
  steering       Steering      @default(RHD)
  groundClearanceMm Int?
  hybridBatteryTech HybridBatteryTech?
  spareAvailability Int?
  importEligibility Boolean?
  sunroof        Boolean       @default(false)
  torque         Int?
  turbo          Boolean       @default(false)
  printCount     Int           @default(0)
  whatsappClicks Int           @default(0)
  images         CarImage[]
  carViews       CarView[]
  reviews        CarReview[]
  branch         DealerBranch? @relation(fields: [branchId], references: [id])
  dealer         Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  leads          Lead[]
  savedBy        SavedCar[]

  @@index([make, model])
  @@index([dealerId])
  @@index([price])
  @@index([year])
  @@index([available])
  @@index([bodyType])
  @@index([fuelType])
  @@index([createdAt])
  @@map("cars")
}

model CarImage {
  id        String  @id @default(cuid())
  carId     String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)
  car       Car     @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_images")
}

model Lead {
  id        String     @id @default(cuid())
  carId     String
  dealerId  String
  name      String
  phone     String
  email     String?
  message   String?
  channel   String     @default("web")
  createdAt DateTime   @default(now())
  status    LeadStatus @default(NEW)
  notes     LeadNote[]
  car       Car        @relation(fields: [carId], references: [id], onDelete: Cascade)
  dealer    Dealer     @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model DealerReview {
  id        String   @id @default(cuid())
  dealerId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealerId, userId])
  @@index([dealerId, createdAt])
  @@index([rating])
  @@map("dealer_reviews")
}

model CarReview {
  id        String   @id @default(cuid())
  carId     String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([carId, userId])
  @@index([carId, createdAt])
  @@index([rating])
  @@map("car_reviews")
}

model LeadNote {
  id        String     @id @default(cuid())
  leadId    String
  status    LeadStatus @default(NEW)
  note      String?
  createdAt DateTime   @default(now())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_notes")
}

model CarView {
  id       String   @id @default(cuid())
  carId    String
  userId   String?
  viewedAt DateTime @default(now())
  source   String?
  car      Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, carId, viewedAt])
  @@map("car_views")
}

model Subscription {
  id        String             @id @default(cuid())
  dealerId  String             @unique
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  mpesaRef  String?
  stripeId  String?
  amount    Int?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  payments  Payment[]
  dealer    Dealer             @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Int
  method         PaymentMethod
  reference      String?
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

model Article {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String   @unique
  urlToImage  String?
  publishedAt DateTime
  sourceName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("articles")
}

enum UserRole {
  ADMIN
  DEALER
  BUYER
}

enum Condition {
  NEW
  USED
  CERTIFIED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum HybridBatteryTech {
  NIMH
  LI_ION
  OTHER
  NA
}

enum Transmission {
  AUTOMATIC
  MANUAL
  CVT
}

enum Drivetrain {
  FWD
  RWD
  AWD
  FOURWD
}

enum Steering {
  RHD
  LHD
}

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  PICKUP
  VAN
  WAGON
  COUPE
  CONVERTIBLE
  BUS
  TRUCK
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NEGOTIATING
  SOLD
  DEAD
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum PaymentMethod {
  MPESA
  CARD
  MANUAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Setting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  
  @@map("settings")
}
