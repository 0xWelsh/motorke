generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(BUYER)
  name         String
  dealerId     String?
  dealer       Dealer?    @relation(fields: [dealerId], references: [id])
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  savedCars    SavedCar[]
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@map("sessions")
}

model SavedCar {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, carId])
  @@map("saved_cars")
}

enum UserRole {
  ADMIN
  DEALER
  BUYER
}

model Dealer {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  phone       String
  whatsapp    String?
  email       String?
  website     String?
  location    String
  county      String   @default("Nairobi")
  address     String?
  lat         Float?
  lng         Float?
  verified    Boolean  @default(false)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cars        Car[]
  leads       Lead[]
  users       User[]
  @@map("dealers")
}

model Car {
  id            String       @id @default(cuid())
  dealerId      String
  dealer        Dealer       @relation(fields: [dealerId], references: [id])
  make          String
  model         String
  variant       String?
  year          Int
  condition     Condition    @default(USED)
  price         Int
  negotiable    Boolean      @default(true)
  mileage       Int?
  fuelType      FuelType     @default(PETROL)
  transmission  Transmission @default(AUTOMATIC)
  driveType     DriveType    @default(RHD)
  engineCC      Int?
  bodyType      BodyType     @default(SEDAN)
  color         String?
  doors         Int?         @default(4)
  seats         Int?         @default(5)
  imported      Boolean      @default(true)
  importCountry String?      @default("Japan")
  dutyPaid      Boolean      @default(true)
  description   String?
  features      String[]
  images        CarImage[]
  available     Boolean      @default(true)
  featured      Boolean      @default(false)
  views         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  leads         Lead[]
  savedBy       SavedCar[]
  @@map("cars")
  @@index([make, model])
  @@index([dealerId])
  @@index([price])
  @@index([year])
}

model CarImage {
  id        String  @id @default(cuid())
  carId     String
  car       Car     @relation(fields: [carId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)
  @@map("car_images")
}

model Lead {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id])
  name      String
  phone     String
  email     String?
  message   String?
  channel   String   @default("web")
  createdAt DateTime @default(now())
  @@map("leads")
}

enum Condition {
  NEW
  USED
  CERTIFIED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum Transmission {
  AUTOMATIC
  MANUAL
  CVT
}

enum DriveType {
  RHD
  LHD
  AWD
  FWD
  RWD
  FOURWD
}

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  PICKUP
  VAN
  WAGON
  COUPE
  CONVERTIBLE
  BUS
  TRUCK
}
