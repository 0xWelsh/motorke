generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String?
  role            UserRole         @default(BUYER)
  name            String
  avatarUrl       String?
  dealerId        String?
  active          Boolean          @default(true)
  emailVerified   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  googleId        String?          @unique
  lat             Float?
  lng             Float?
  savedCars       SavedCar[]
  sessions        Session[]
  notifications   Notification[]
  dealerReviews   DealerReview[]
  carReviews      CarReview[]
  carViews        CarView[]
  marketingEvents MarketingEvent[]
  leads           Lead[]
  buyerRequests   BuyerRequest[]
  dealer          Dealer?          @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @default("GENERAL")
  title     String
  message   String
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model SavedCar {
  id        String   @id @default(cuid())
  userId    String
  carId     String
  createdAt DateTime @default(now())
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@map("saved_cars")
}

model Dealer {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  description  String?
  logoUrl      String?
  bannerUrl    String?
  phone        String
  whatsapp     String?
  email        String?
  website      String?
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  responseTime String?
  location     String
  county       String               @default("Nairobi")
  address      String?
  lat          Float?
  lng          Float?
  type                      DealerType           @default(BROKER)
  verified                  Boolean              @default(false)
  verificationStatus        VerificationStatus   @default(UNVERIFIED)
  verificationApprovedAt    DateTime?
  verificationApprovedBy    String?
  verificationRejectionReason String?
  featured     Boolean              @default(false)
  boostScore      Int                  @default(0)
  dealerLiftUntil DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  cars            Car[]
  boostBalance    DealerBoostBalance?
  boostEvents     ListingBoostEvent[]
  branches     DealerBranch[]
  leads        Lead[]
  reviews      DealerReview[]
  subscription            Subscription?
  users                   User[]
  gallery                 DealerGalleryMedia[]
  buyerRequestOffers      BuyerRequestOffer[]
  buyerRequestPassUntil   DateTime?
  growthProspects         GrowthProspect[]
  verificationRequests    VerificationRequest[]

  @@index([type])
  @@index([verificationStatus])
  @@index([county])
  @@map("dealers")
}

model DealerGalleryMedia {
  id        String   @id @default(cuid())
  dealerId  String
  url       String
  type      String // 'image' or 'video'
  caption   String?
  createdAt DateTime @default(now())
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@map("dealer_gallery_media")
}

model DealerBranch {
  id        String   @id @default(cuid())
  dealerId  String
  name      String
  location  String
  county    String   @default("Nairobi")
  address   String?
  lat       Float?
  lng       Float?
  phone     String?
  whatsapp  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cars      Car[]
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@map("dealer_branches")
}

model Car {
  id                  String             @id @default(cuid())
  dealerId            String
  vehicleType         VehicleType        @default(CAR)
  make                String
  model               String
  variant             String?
  year                Int
  condition           Condition          @default(USED)
  price               Int
  computedLandedPrice Int?
  negotiable          Boolean            @default(true)
  mileage             Int?
  fuelType            FuelType           @default(PETROL)
  transmission        Transmission       @default(AUTOMATIC)
  engineCC            Int?
  bodyType            BodyType           @default(SEDAN)
  color               String?
  doors               Int?               @default(4)
  seats               Int?               @default(5)
  imported            Boolean            @default(true)
  importCountry       String?            @default("Japan")
  dutyPaid            Boolean            @default(true)
  registered          Boolean            @default(true)
  description         String?
  features            String[]
  videoUrl            String?
  available           Boolean            @default(true)
  soldAt              DateTime?
  featured            Boolean            @default(false)
  featuredWeight      Int                @default(0)
  spotlightUntil      DateTime?
  hotBadgeUntil       DateTime?
  views               Int                @default(0)
  boostEvents         ListingBoostEvent[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  branchId            String?
  drivetrain          Drivetrain         @default(FWD)
  badges              String[]
  airbags             Int?               @default(0)
  cylinders           Int?
  horsepower          Int?
  steering            Steering           @default(RHD)
  groundClearanceMm   Int?
  hybridBatteryTech   HybridBatteryTech?
  spareAvailability   Int?
  importEligibility   Boolean?
  sunroof             Boolean            @default(false)
  torque              Int?
  turbo               Boolean            @default(false)
  printCount          Int                @default(0)
  whatsappClicks      Int                @default(0)
  location            String?
  publicSlug          String?            @unique
  images              CarImage[]
  carViews            CarView[]
  reviews             CarReview[]
  branch              DealerBranch?      @relation(fields: [branchId], references: [id])
  dealer              Dealer             @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  leads               Lead[]
  savedBy             SavedCar[]

  @@index([make, model])
  @@index([dealerId])
  @@index([price])
  @@index([computedLandedPrice])
  @@index([year])
  @@index([available])
  @@index([soldAt])
  @@index([bodyType])
  @@index([fuelType])
  @@index([createdAt])
  @@index([featured])
  @@index([views])
  @@index([featuredWeight])
  @@index([spotlightUntil])
  @@map("cars")
}

model CarModelSpec {
  id              String             @id @default(cuid())
  make            String
  model           String
  variant         String?
  yearStart       Int
  yearEnd         Int?
  bodyType        BodyType?
  vehicleType     VehicleType?
  published       Boolean            @default(false)
  imageUrl        String?
  engineCC        Int?
  cylinders       Int?
  horsepower      Int?
  torque          Int?
  fuelType        FuelType?
  transmission    Transmission?
  drivetrain      Drivetrain?
  steering        Steering?
  seats           Int?
  doors           Int?
  airbags         Int?
  groundClearanceMm Int?
  hybridBatteryTech HybridBatteryTech?
  turbo           Boolean?
  sunroof         Boolean?
  curbWeightKg    Int?
  fuelTankLiters  Int?
  standardFeatures String[]
  source          String?
  verified        Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([make, model, variant, yearStart])
  @@index([make, model])
  @@index([make])
  @@map("car_model_specs")
}

model CarImage {
  id        String  @id @default(cuid())
  carId     String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)
  car       Car     @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId, isPrimary])
  @@map("car_images")
}

model Lead {
  id        String     @id @default(cuid())
  carId     String
  dealerId  String
  userId    String?
  name      String
  phone     String
  email     String?
  message   String?
  channel   String     @default("web")
  createdAt DateTime   @default(now())
  status    LeadStatus @default(NEW)
  notes     LeadNote[]
  car       Car        @relation(fields: [carId], references: [id], onDelete: Cascade)
  dealer    Dealer     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([dealerId, createdAt])
  @@map("leads")
}

model DealerReview {
  id        String   @id @default(cuid())
  dealerId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealerId, userId])
  @@index([dealerId, createdAt])
  @@index([rating])
  @@map("dealer_reviews")
}

model VerificationRequest {
  id        String   @id @default(cuid())
  dealerId  String
  status    String   @default("SUBMITTED")
  reason    String?
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  documents String[] @default([])
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, submittedAt(sort: Desc)])
  @@index([status])
  @@map("verification_requests")
}

model CarReview {
  id        String   @id @default(cuid())
  carId     String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([carId, userId])
  @@index([carId, createdAt])
  @@index([rating])
  @@map("car_reviews")
}

model LeadNote {
  id        String     @id @default(cuid())
  leadId    String
  status    LeadStatus @default(NEW)
  note      String?
  createdAt DateTime   @default(now())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_notes")
}

model CarView {
  id         String   @id @default(cuid())
  carId      String
  userId     String?
  // Stable per-device key (the `wmh-rot` cookie) used to dedupe
  // anonymous refresh-spam inside a 30-minute window.
  sessionKey String?
  viewedAt   DateTime @default(now())
  // Classified referrer at the moment of view: "facebook" | "whatsapp"
  // | "google" | "tiktok" | "internal" | "direct" | "external" etc.
  source     String?
  car        Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, carId, viewedAt])
  @@index([sessionKey, carId, viewedAt])
  @@index([carId, viewedAt])
  @@map("car_views")
}

model MarketingEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  source    String?
  payload   Json?
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@map("marketing_events")
}

model DealerBoostBalance {
  id           String   @id @default(cuid())
  dealerId     String   @unique
  spotlight7d  Int      @default(0)
  spotlight30d Int      @default(0)
  hotBadge7d   Int      @default(0)
  dealerLift14d Int     @default(0)
  periodStart  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  dealer       Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@map("dealer_boost_balances")
}

model ListingBoostEvent {
  id        String   @id @default(cuid())
  dealerId  String
  carId     String?
  boostType String
  days      Int
  endsAt    DateTime
  source    String   @default("portal")
  charged   Boolean  @default(false)
  createdAt DateTime @default(now())
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  car       Car?     @relation(fields: [carId], references: [id], onDelete: SetNull)

  @@index([dealerId, createdAt(sort: Desc)])
  @@index([carId])
  @@map("listing_boost_events")
}

model Subscription {
  id        String             @id @default(cuid())
  dealerId  String             @unique
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  mpesaRef  String?
  stripeId  String?
  amount    Int?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  payments  Payment[]
  dealer    Dealer             @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Int
  method         PaymentMethod
  reference      String?
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

model Article {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String   @unique
  urlToImage  String?
  publishedAt DateTime
  sourceName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("articles")
}

model SearchAlert {
  id              String        @id @default(cuid())
  phone           String
  email           String?
  make            String?
  model           String?
  minPrice        Int?
  maxPrice        Int?
  minYear         Int?
  bodyType        BodyType?
  fuelType        FuelType?
  transmission    Transmission?
  active          Boolean       @default(true)
  lastNotifiedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([phone])
  @@index([active])
  @@map("search_alerts")
}

enum UserRole {
  ADMIN
  DEALER
  BUYER
}

enum DealerType {
  DEALERSHIP
  BROKER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum Condition {
  NEW
  USED
  CERTIFIED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum HybridBatteryTech {
  NIMH
  LI_ION
  OTHER
  NA
}

enum Transmission {
  AUTOMATIC
  MANUAL
  CVT
}

enum Drivetrain {
  FWD
  RWD
  AWD
  FOURWD
}

enum Steering {
  RHD
  LHD
}

enum VehicleType {
  CAR
  MOTORBIKE
}

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  PICKUP
  VAN
  WAGON
  COUPE
  CONVERTIBLE
  CROSSOVER
  MPV
  MINIVAN
  ROADSTER
  LIFTBACK
  BUS
  TRUCK
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NEGOTIATING
  SOLD
  DEAD
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum PaymentMethod {
  MPESA
  CARD
  MANUAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

/// KRA-style CRSP reference row for the public import duty calculator (not live inventory).
model DutyVehicle {
  id        String   @id @default(cuid())
  make      String
  model     String
  trim      String?
  year      Int
  engineCC  Int
  fuelType  FuelType @default(PETROL)
  bodyType  BodyType?
  crspKes   Int
  slug      String   @unique
  active    Boolean  @default(true)
  source    String?  @default("seed")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calculations DutyCalculation[]

  @@index([make, model])
  @@index([year])
  @@index([active])
  @@map("duty_vehicles")
}

/// Anonymous calculator usage for demand intelligence.
model DutyCalculation {
  id            String       @id @default(cuid())
  dutyVehicleId String?
  searchQuery   String?
  make          String?
  model         String?
  year          Int?
  engineCC      Int?
  fuelType      FuelType?
  crspKes       Int?
  totalKes      Int
  breakdown     Json
  sessionKey    String?
  createdAt     DateTime     @default(now())
  dutyVehicle   DutyVehicle? @relation(fields: [dutyVehicleId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([dutyVehicleId])
  @@index([make, model])
  @@map("duty_calculations")
}

model Setting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

enum SeoContentStatus {
  DRAFT
  PUBLISHED
}

enum SeoContentType {
  BLOG
  COMPARISON
  LANDING
}

model SearchQueryLog {
  id           String   @id @default(cuid())
  query        String
  normalized   String
  sessionKey   String?
  userId       String?
  resultCount  Int?
  createdAt    DateTime @default(now())

  @@index([normalized, createdAt])
  @@index([createdAt])
  @@map("search_query_logs")
}

model SeoContentPage {
  id          String           @id @default(cuid())
  type        SeoContentType
  slug        String           @unique
  title       String
  description String?
  body        String?          @db.Text
  meta        Json?
  status      SeoContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type, status])
  @@map("seo_content_pages")
}

model SeoAuditRun {
  id        String   @id @default(cuid())
  ok        Boolean
  summary   Json
  issues    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("seo_audit_runs")
}

model SeoCrawlRun {
  id        String          @id @default(cuid())
  ok        Boolean
  source    String          @default("cron")
  meta      Json?
  createdAt DateTime        @default(now())
  entries   SeoCrawlEntry[]

  @@index([createdAt])
  @@map("seo_crawl_runs")
}

model SeoCrawlEntry {
  id         String      @id @default(cuid())
  runId      String
  run        SeoCrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  url        String
  status     Int         @default(0)
  title      String?
  error      String?
  durationMs Int         @default(0)

  @@index([runId])
  @@map("seo_crawl_entries")
}

model SeoGscSync {
  id        String      @id @default(cuid())
  siteUrl   String
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  syncedAt  DateTime    @default(now())
  rows      SeoGscRow[]

  @@index([syncedAt])
  @@map("seo_gsc_syncs")
}

model SeoGscRow {
  id          String     @id @default(cuid())
  syncId      String
  sync        SeoGscSync @relation(fields: [syncId], references: [id], onDelete: Cascade)
  dimension   String
  key         String
  clicks      Int        @default(0)
  impressions Int        @default(0)
  ctr         Float      @default(0)
  position    Float      @default(0)

  @@unique([syncId, dimension, key])
  @@index([syncId, dimension])
  @@map("seo_gsc_rows")
}

enum SeoJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum SeoJobType {
  CRAWL
  GSC_SYNC
  GSC_DAILY
  PAGESPEED
  AUDIT
  CONTENT_SYNC
  LISTING_SEO
}

/// Kenya buyer-guide copy keyed by make/model (template, curated import, or AI).
model ModelSeoGuide {
  id         String   @id @default(cuid())
  make       String
  model      String
  headline   String
  paragraphs String[]
  bullets    String[] @default([])
  source     String   @default("template")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([make, model])
  @@index([make])
  @@map("model_seo_guides")
}

model SeoJob {
  id          String       @id @default(cuid())
  type        SeoJobType
  status      SeoJobStatus @default(PENDING)
  payload     Json?
  result      Json?
  error       String?
  attempts    Int          @default(0)
  maxAttempts Int          @default(3)
  scheduledAt DateTime     @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, scheduledAt])
  @@index([type, createdAt])
  @@map("seo_jobs")
}

model SeoGscDailyMetric {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  syncedAt    DateTime @default(now())

  @@unique([date])
  @@index([date])
  @@map("seo_gsc_daily_metrics")
}

model SeoPageSpeedRun {
  id              String   @id @default(cuid())
  url             String
  strategy        String
  performance     Int?
  accessibility   Int?
  bestPractices   Int?
  seoScore        Int?
  lcpMs           Float?
  fcpMs           Float?
  cls             Float?
  createdAt       DateTime @default(now())

  @@index([url, strategy, createdAt])
  @@map("seo_pagespeed_runs")
}

enum BuyerRequestStatus {
  OPEN
  MATCHED
  CLOSED
  EXPIRED
}

/// Buyer "car wanted" request — sellers respond via Welsh Motorhub (phone hidden on public board).
model BuyerRequest {
  id              String             @id @default(cuid())
  publicCode      String             @unique
  userId          String?
  name            String
  phone           String
  make            String
  model           String
  variant         String?
  yearMin         Int?
  yearMax         Int?
  budgetMin       Int?
  budgetMax       Int
  bodyType        BodyType?
  fuelType        FuelType?
  transmission    Transmission?
  mileageMin      Int?
  mileageMax      Int?
  county          String
  timeline        String             @default("ASAP")
  conditionPref   String             @default("EITHER")
  features        String[]           @default([])
  notes           String?
  consentWhatsapp Boolean            @default(true)
  status          BuyerRequestStatus @default(OPEN)
  expiresAt       DateTime
  offerClicks     Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  offers          BuyerRequestOffer[]

  @@index([status, expiresAt])
  @@index([county, status])
  @@index([make, model])
  @@index([createdAt])
  @@map("buyer_requests")
}

model BuyerRequestOffer {
  id             String       @id @default(cuid())
  dealerId       String
  buyerRequestId String
  createdAt      DateTime     @default(now())
  dealer         Dealer       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  buyerRequest   BuyerRequest @relation(fields: [buyerRequestId], references: [id], onDelete: Cascade)

  @@unique([dealerId, buyerRequestId])
  @@index([dealerId, createdAt])
  @@map("buyer_request_offers")
}

/// Gallery posts — event photography or magazine features.
model GalleryPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  type          String   @default("event")
  title         String
  date          DateTime
  location      String?
  description   String?
  coverImage    String?
  images        Json?
  magazineLink  String?
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type, published])
  @@index([date])
  @@index([slug])
  @@map("gallery_posts")
}

enum GrowthProspectStatus {
  DISCOVERED
  CONTACT_COLLECTED
  OUTREACH_PLANNED
  CONTACTED
  INTERESTED
  ONBOARDED
  DECLINED
  DORMANT
}

enum GrowthOutreachChannel {
  WHATSAPP
  CALL
  EMAIL
  VISIT
  SMS
  OTHER
}

enum GrowthOutreachStatus {
  PLANNED
  SENT
  REPLIED
  NO_RESPONSE
  BOUNCED
  CANCELLED
}

/// Dealer acquisition pipeline (Welsh MotorHub Growth Agent).
model GrowthProspect {
  id                 String                 @id @default(cuid())
  name               String
  source             String                 @default("manual")
  sourceUrl          String?
  phone              String?
  whatsapp           String?
  email              String?
  website            String?
  facebookUrl        String?
  instagramUrl       String?
  location           String?
  county             String                 @default("Nairobi")
  address            String?
  lat                Float?
  lng                Float?
  status             GrowthProspectStatus   @default(DISCOVERED)
  tags               String[]               @default([])
  notes              String?
  inventoryUrl       String?
  inventoryCount     Int                    @default(0)
  inventoryCountPrev Int?
  inventoryCheckedAt DateTime?
  matchedDealerId    String?
  outreachCount      Int                    @default(0)
  lastOutreachAt     DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  matchedDealer      Dealer?                @relation(fields: [matchedDealerId], references: [id], onDelete: SetNull)
  outreachEvents     GrowthOutreachEvent[]
  inventorySnapshots GrowthInventorySnapshot[]

  @@index([status, county])
  @@index([matchedDealerId])
  @@index([phone])
  @@index([createdAt])
  @@map("growth_prospects")
}

model GrowthOutreachEvent {
  id          String                @id @default(cuid())
  prospectId  String
  channel     GrowthOutreachChannel
  status      GrowthOutreachStatus  @default(PLANNED)
  direction   String                @default("OUTBOUND")
  subject     String?
  body        String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdBy   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  prospect    GrowthProspect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
  @@index([status, scheduledAt])
  @@map("growth_outreach_events")
}

model GrowthInventorySnapshot {
  id             String         @id @default(cuid())
  prospectId     String
  source         String
  inventoryCount Int
  delta          Int            @default(0)
  rawNote        String?
  capturedAt     DateTime       @default(now())
  prospect       GrowthProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, capturedAt])
  @@map("growth_inventory_snapshots")
}
