# Prisma connection strings for Supabase + Vercel
# 1. DATABASE_URL: Use the Transaction Pooler (Port 6543) for the application.
#    Include ?pgbouncer=true for Prisma to handle connections correctly.
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"

# 2. DIRECT_URL: Use the Pooler host (Port 5432) for Prisma Migrations (Session Mode).
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# Auth
AUTH_SECRET="your-random-secret-key-min-32-chars"

# Email/SMTP (for password resets, verification emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Supabase (Storage for car images)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Safaricom M-Pesa (Daraja API)
MPESA_CONSUMER_KEY="your-consumer-key-from-safaricom"
MPESA_CONSUMER_SECRET="your-consumer-secret-from-safaricom"
MPESA_PASSKEY="your-passkey-from-m-pesa-portal"
MPESA_SHORTCODE="174379"
MPESA_ENV="sandbox"  # Change to "production" when live
MPESA_CALLBACK_URL="https://motorske.com/api/webhooks/mpesa"  # Your production domain
MPESA_WEBHOOK_SECRET="your-custom-webhook-secret-for-signature-validation"

# CAPTCHA (either Turnstile or reCAPTCHA, not both)
# Cloudflare Turnstile (recommended for Kenya)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# OR Google reCAPTCHA (optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Google OAuth (optional - comment out to disable)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Monitoring (optional)
SENTRY_DSN=""

# Node environment
NODE_ENV="development"

# Optional — free-tier AI paragraph on /compare (get keys at $0: Groq or Google AI Studio)
# GROQ_API_KEY="gsk_..."
# or
# GEMINI_API_KEY="..."
# optional override if your project uses a different model id
# GEMINI_MODEL="gemini-1.5-flash"
