# Prisma connection strings for Supabase + Vercel
# 1. DATABASE_URL: Transaction pooler (port 6543). On serverless use a low
#    connection_limit (often 1) per instance — see Prisma + Supabase docs.
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=60&connect_timeout=15"

# 2. DIRECT_URL: Prisma migrate ONLY — copy **Session pooler** from Supabase
#    Dashboard → Connect (port 5432). Do NOT reuse the :6543 transaction URL.
#    db.<ref>.supabase.co is often IPv6-only; Session pooler works on IPv4.
#    Example (no pgbouncer= param):
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional (Vercel env): P1002 during migrate — migrate-deploy.sh retries with disable-lock automatically.
# Set PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 only if you want that on the **first** migrate attempt.

# Auth
AUTH_SECRET="your-random-secret-key-min-32-chars"
NEXT_PUBLIC_SITE_URL="https://welshmotorhub.co.ke"
NEXT_PUBLIC_APP_URL="https://welshmotorhub.co.ke"

# --- Email (transactional: signup verification, password reset, lead alerts, watch alerts) ---
# You need ONE SMTP login (below). "From" addresses can still be different @welshmotorhub.co.ke
# if your provider allows aliases (Google Workspace, Zoho, Microsoft 365) or if you use a
# relay (Resend, SendGrid, Mailgun) that verifies the domain.
#
# Typical setup for welshmotorhub.co.ke:
# 1) Buy/host DNS at Cloudflare (or your registrar).
# 2) Either:
#    A) Google Workspace / Zoho / Microsoft 365 — create mailboxes or aliases:
#       noreply@, hello@, dealers@, security@ (aliases can all forward to you or one inbox).
#       SMTP_USER is often your primary login; add "Send mail as" for each alias in Gmail.
#    B) Cloudflare Email Routing — free forwarding only (good for hello@ → Gmail), NOT for
#       sending from noreply@ via SMTP unless you pair it with a sending provider.
#    C) Resend / SendGrid — verify domain (SPF + DKIM DNS records), use their SMTP/API;
#       set SMTP_HOST/PORT from their docs and MAIL_FROM_* below to @welshmotorhub.co.ke.
#
# Zoho Mail (free org): smtp.zoho.com + 587 + TLS — use full mailbox as SMTP_USER; From must be that mailbox or an alias.
# SMTP_SECURE="false" when using port 587.
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="hello@welshmotorhub.co.ke"
SMTP_PASS="your-zoho-app-specific-password"
# Public support — shown on footer, contact, FAQ, terms/privacy (set in Vercel for production)
NEXT_PUBLIC_MAIL_SUPPORT="hello@welshmotorhub.co.ke"
# Optional — shown in the top contact strip (e.g. +254 712 345 678)
NEXT_PUBLIC_SUPPORT_PHONE=""
# Optional — WhatsApp for homepage support FAB (defaults to SUPPORT_PHONE)
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
# Optional — prefilled text when buyers tap homepage WhatsApp support
NEXT_PUBLIC_SUPPORT_WHATSAPP_MESSAGE="Hi Welsh Motorhub team, I need help with the website."
# Optional server override for HTML email footers (defaults to NEXT_PUBLIC_MAIL_SUPPORT)
MAIL_SUPPORT="hello@welshmotorhub.co.ke"
# Transactional From headers — must be SMTP_USER or an alias on that user (Zoho "relaying" rule).
# Default below matches SMTP_USER=hello@. Switch all to noreply@ once noreply is an alias on that mailbox.
MAIL_FROM_VERIFICATION="Welsh Motorhub <hello@welshmotorhub.co.ke>"
MAIL_FROM_NOREPLY="Welsh Motorhub <hello@welshmotorhub.co.ke>"
# Welcome email From (defaults to hello@welshmotorhub.co.ke)
# MAIL_FROM_HELLO="Welsh Motorhub <hello@welshmotorhub.co.ke>"
# Optional overrides (else code falls back to MAIL_FROM_NOREPLY)
# MAIL_FROM_ALERTS="Welsh Motorhub <hello@welshmotorhub.co.ke>"
# MAIL_FROM_MARKETING="Welsh Motorhub <noreply@welshmotorhub.co.ke>"

# Supabase (Storage for car images)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Maintenance mode
# Set MAINTENANCE_MODE=on to redirect all public traffic to /maintenance.
# Admin/portal sessions and the bypass cookie keep working.
# To grant yourself bypass without logging in:
#   /api/bypass-maintenance?token=<MAINTENANCE_BYPASS_TOKEN>&next=/
# MAINTENANCE_MODE="off"
# MAINTENANCE_BYPASS_TOKEN="set-a-long-random-string-here"

# Safaricom M-Pesa (Daraja API)
MPESA_CONSUMER_KEY="your-consumer-key-from-safaricom"
MPESA_CONSUMER_SECRET="your-consumer-secret-from-safaricom"
MPESA_PASSKEY="your-passkey-from-m-pesa-portal"
MPESA_SHORTCODE="174379"
MPESA_ENV="sandbox"  # Change to "production" when live
MPESA_CALLBACK_URL="https://welshmotorhub.co.ke/api/webhooks/mpesa"
MPESA_WEBHOOK_SECRET="your-custom-webhook-secret-for-signature-validation"

# CAPTCHA (either Turnstile or reCAPTCHA, not both)
# Cloudflare Turnstile (recommended for Kenya)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# OR Google reCAPTCHA (optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Google OAuth (optional - comment out to disable)
GOOGLE_CLIENT_ID="your-google-client-id"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Monitoring (optional)
SENTRY_DSN=""
CRON_SECRET="your-long-random-cron-secret"

# Node environment
NODE_ENV="development"

# Optional — Groq or Google Gemini for the compare page narrative (server-side)
# GROQ_API_KEY="gsk_..."
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-1.5-flash"

# Optional — xAI Grok (server-side): compare “pick lines”, admin parse/models/variants, etc.
# Put the real value only in .env.local (gitignored), never in the repo.
# XAI_API_KEY="xai-..."
# XAI_MODEL="grok-2-latest"

# Optional — Go search shadow rollout (safe migration)
# Keep both disabled initially.
GO_SEARCH_SERVICE_URL="http://127.0.0.1:8081"
GO_SEARCH_SHADOW_ENABLED="false"
GO_SEARCH_SHADOW_SAMPLE_PERCENT="10"
GO_SEARCH_TIMEOUT_MS="350"
GO_SEARCH_LOG_MATCHES="false"
GO_SEARCH_ACTIVE_ENABLED="false"

# --- SEO ---
# Optional: Google Indexing API when a listing is published (service account JSON one line)
# GOOGLE_INDEXING_ENABLED="false"
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Go SEO crawler (services/seo-worker) — deploy separately; falls back to HEAD checks if unset
# SEO_WORKER_URL="http://127.0.0.1:8090"
# SEO_WORKER_SECRET=""
# Phase 3: Google Search Console sync (rankings / queries / pages in admin)
# GSC_SYNC_ENABLED="false"
# GSC_SITE_URL="sc-domain:welshmotorhub.co.ke"
# Or: GSC_SITE_URL="https://welshmotorhub.co.ke"
# GSC_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Cron: /api/cron/seo-monitor?secret=CRON_SECRET  (enqueue + process job queue)
# Google PageSpeed Insights API key (Cloud Console → APIs → PageSpeed Insights)
# GOOGLE_PAGESPEED_API_KEY=""
# SEO_PAGESPEED_ALERT_THRESHOLD="50"
# Email alerts on crawl/audit failures (default on); Slack optional
# SEO_ALERTS_ENABLED="true"
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Bing / Google site ownership (meta tag in <head> via src/app/layout.js)
# Easier than XML upload: copy the content= value from Bing's meta tag verification option
# NEXT_PUBLIC_BING_SITE_VERIFICATION=""
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# XML alternative: public/BingSiteAuth.xml (must match Bing download exactly)


