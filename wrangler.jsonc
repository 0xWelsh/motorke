{
  "$schema": "https://schema.cloudflare.com/schemas/wrangler-config-1.json",
  "name": "motorke",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "motorke-images"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "observability": {
    "enabled": true
  }
}