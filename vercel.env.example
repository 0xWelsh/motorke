# =============================================================================
# Vercel environment import — TEMPLATE ONLY (no real secrets in git)
# =============================================================================
# 1. Copy this file:  cp vercel.env.example vercel.env
# 2. Replace every placeholder with production values (same as you would set on Vercel).
# 3. Vercel → Project → Settings → Environment Variables → "Import" / paste from vercel.env
# 4. Target: Production (and Preview if you want preview deploys to work the same).
# 5. Never commit vercel.env (see .gitignore).
# =============================================================================

# --- Prisma (Supabase: Transaction pooler port 6543 for DATABASE_URL) ---
# On Vercel serverless, prefer connection_limit=1 per instance (see Prisma +
# Supabase docs); raise pool_timeout if you still see P2024 under burst load.
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=60"
# Migrations / introspection: use the direct DB host (Dashboard → Database → URI), not :6543.
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --- Auth ---
AUTH_SECRET="min-32-chars-random-use-openssl-rand-base64-32"

# --- Public site URLs ---
NEXT_PUBLIC_SITE_URL="https://welshmotorhub.co.ke"
NEXT_PUBLIC_APP_URL="https://welshmotorhub.co.ke"

# --- Zoho Mail (SMTP_USER must match mailbox used for SMTP_PASS; From must be that user or alias) ---
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="hello@welshmotorhub.co.ke"
SMTP_PASS="your-zoho-application-specific-password"
NEXT_PUBLIC_MAIL_SUPPORT="hello@welshmotorhub.co.ke"
MAIL_SUPPORT="hello@welshmotorhub.co.ke"
MAIL_FROM_VERIFICATION="Welsh Motorhub <hello@welshmotorhub.co.ke>"
MAIL_FROM_NOREPLY="Welsh Motorhub <hello@welshmotorhub.co.ke>"
MAIL_FROM_ALERTS="Welsh Motorhub <hello@welshmotorhub.co.ke>"
MAIL_FROM_MARKETING="Welsh Motorhub <hello@welshmotorhub.co.ke>"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- M-Pesa Daraja (use production values when live) ---
MPESA_CONSUMER_KEY="your-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="your-mpesa-consumer-secret"
MPESA_PASSKEY="your-mpesa-passkey"
MPESA_SHORTCODE="174379"
MPESA_ENV="production"
MPESA_CALLBACK_URL="https://welshmotorhub.co.ke/api/webhooks/mpesa"
MPESA_WEBHOOK_SECRET="your-webhook-signing-secret"

# --- Cloudflare Turnstile (recommended) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# --- Google reCAPTCHA (leave empty if using Turnstile only) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# --- Google OAuth (optional; leave empty to disable) ---
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cron (watch alerts, etc.) ---
CRON_SECRET="long-random-string-for-bearer-cron-auth"

# --- Optional monitoring ---
SENTRY_DSN=""

# --- Optional AI (enable only if you use these features) ---
# XAI_API_KEY=""
# XAI_MODEL="grok-2-latest"
# GROQ_API_KEY=""
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-1.5-flash"

# --- Optional Go search service (only if deployed) ---
# GO_SEARCH_SERVICE_URL="https://your-go-search.internal"
# GO_SEARCH_SHADOW_ENABLED="false"
# GO_SEARCH_SHADOW_SAMPLE_PERCENT="10"
# GO_SEARCH_TIMEOUT_MS="350"
# GO_SEARCH_LOG_MATCHES="false"
# GO_SEARCH_ACTIVE_ENABLED="false"
